{
    "functions": {
        "source": "firebase/functions",
        "codebase": "public-feeds",
        "runtime": "nodejs22"
    },
    "firestore": {
        "rules": "firebase/firestore.rules",
        "indexes": "firebase/firestore.indexes.json"
    },
    "hosting": {
        "public": "om_sai_ram/build/web",
        "ignore": [
            "firebase.json",
            "**/.*"
        ],
        "rewrites": [
            {
                "source": "**",
                "destination": "/index.html"
            }
        ]
    },
    "emulators": {
        "functions": {
            "host": "127.0.0.1",
            "port": 5001
        },
        "auth": {
            "host": "127.0.0.1",
            "port": 9099
        },
        "firestore": {
            "host": "127.0.0.1",
            "port": 8085
        },
        "ui": {
            "enabled": true,
            "host": "127.0.0.1",
            "port": 4000
        },
        "hub": {
            "host": "127.0.0.1",
            "port": 4400
        },
        "logging": {
            "host": "127.0.0.1",
            "port": 4500
        },
        "singleProjectMode": true
    }
}