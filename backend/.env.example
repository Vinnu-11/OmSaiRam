# Om Sai Ram — Backend Environment Variables
# Copy this file to .env and fill in the values.

# Database
DATABASE_URL=postgresql://omsairam:omsairam@localhost:5432/omsairam

# JWT (CHANGE THESE IN PRODUCTION!)
JWT_SECRET_KEY=change-this-to-a-random-secret-in-production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# CORS
CORS_ORIGINS=["*"]

# Google OAuth (configure for social login)
GOOGLE_CLIENT_ID=your-google-client-id-here

# App
DEBUG=true
